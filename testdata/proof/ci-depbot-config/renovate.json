{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "automerge": true,
  "rangeStrategy": "bump",
  "groupName": "minor-and-patch",
  "packageRules": [
    {
      "automerge": true,
      "matchFileNames": [".tekton/**", ".github/**", "Dockerfile"]
    },
    {
      "matchManagers": ["gomod"],
      "enabled": false
    }
  ]
}
